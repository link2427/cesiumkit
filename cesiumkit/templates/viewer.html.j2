<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <script src="{{ cesium_js_url }}"></script>
    <link href="{{ cesium_css_url }}" rel="stylesheet">
    <style>
        html, body, #{{ container_id }} {
            width: {{ width }};
            height: {{ height }};
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <div id="{{ container_id }}"></div>
    <script>
        {% if ion_token %}
        Cesium.Ion.defaultAccessToken = '{{ ion_token }}';
        {% endif %}

        {% if not ion_token %}
        // No Ion token -- use the NaturalEarthII tiles that ship with Cesium.
        // We deliberately avoid `ImageryLayer.fromProviderAsync(...)` here: in
        // headless chromium the promise chain was leaving the layer stuck with
        // no attached provider, and the globe rendered as empty skybox. Using
        // UrlTemplateImageryProvider with a direct template URL bypasses the
        // async path entirely -- the provider is ready the moment it's
        // constructed.
        const _naturalEarthUrl = Cesium.buildModuleUrl("Assets/Textures/NaturalEarthII/") + "{z}/{x}/{reverseY}.jpg";
        const viewerOptions = Object.assign({}, {{ viewer_options }});
        if (!viewerOptions.baseLayer) {
            viewerOptions.baseLayer = new Cesium.ImageryLayer(
                new Cesium.UrlTemplateImageryProvider({
                    url: _naturalEarthUrl,
                    tilingScheme: new Cesium.GeographicTilingScheme(),
                    maximumLevel: 2,
                    credit: "Natural Earth II"
                })
            );
        }
        if (viewerOptions.baseLayerPicker === undefined) viewerOptions.baseLayerPicker = false;
        if (viewerOptions.geocoder === undefined) viewerOptions.geocoder = false;
        {% else %}
        const viewerOptions = {{ viewer_options }};
        {% endif %}

        const viewer = new Cesium.Viewer('{{ container_id }}', viewerOptions);
        // Expose the viewer on window so external tools (playwright, devtools,
        // custom scripts) can reach it. `const` is script-scoped so we need
        // to attach it explicitly.
        window.viewer = viewer;

        // Allow scripts in the InfoBox iframe to suppress sandbox warnings
        if (viewer.infoBox) {
            viewer.infoBox.frame.removeAttribute('sandbox');
            viewer.infoBox.frame.src = 'about:blank';
        }

        {% if terrain_statement %}
        // Terrain providers are resolved asynchronously in Cesium 1.10x+;
        // assign after construction rather than passing a Promise to the
        // viewer options.
        (async () => {
            try {
                viewer.scene.terrainProvider = await {{ terrain_statement }};
            } catch (error) {
                console.error('Error loading terrain:', error);
            }
        })();
        {% endif %}

        {% for stmt in clustering_statements %}
        {{ stmt }}
        {% endfor %}

        {% for stmt in scene_statements %}
        {{ stmt }}
        {% endfor %}

        {% for stmt in globe_statements %}
        {{ stmt }}
        {% endfor %}

        {% for stmt in clock_statements %}
        {{ stmt }}
        {% endfor %}

        {% for entity_js in entities %}
        viewer.entities.add({{ entity_js }});
        {% endfor %}

        {% for ds_js in data_sources %}
        var _ds = {{ ds_js }};
        viewer.dataSources.add(_ds);
        {% for stmt in data_source_entity_statements[loop.index0] %}
        {{ stmt }}
        {% endfor %}
        {% endfor %}

        {% for tileset_js in tilesets %}
        (async () => {
            try {
                const tileset = await {{ tileset_js }};
                viewer.scene.primitives.add(tileset);
            } catch (error) {
                console.error('Error loading tileset:', error);
            }
        })();
        {% endfor %}

        {% for primitive_js in primitives %}
        viewer.scene.primitives.add({{ primitive_js }});
        {% endfor %}

        {% for camera_op in camera_operations %}
        {{ camera_op }}
        {% endfor %}

        {% for event_js in event_handlers %}
        {{ event_js }};
        {% endfor %}

        {% for custom_js in custom_scripts %}
        {{ custom_js }}
        {% endfor %}

        // ── Runtime command bridge ──
        async function __cesiumkitPostResult(requestId, result, error) {
            const response = await fetch('/__cesiumkit_result', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({requestId, result, error}),
            });
            if (!response.ok) throw new Error('Failed to return runtime command result');
        }

        async function __cesiumkitPostEvent(event, result) {
            const response = await fetch('/__cesiumkit_result', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({event, result}),
            });
            if (!response.ok) throw new Error('Failed to return runtime event');
        }

        let _cesiumkitCmdSeq = 0;
        async function _cesiumkitPollCommands() {
            try {
                const resp = await fetch('/__cesiumkit_cmd?seq=' + _cesiumkitCmdSeq);
                if (!resp.ok) return;
                const cmd = await resp.json();
                if (cmd.js) {
                    try {
                        eval(cmd.js);
                    } catch (error) {
                        console.error('cesiumkit runtime command failed:', error);
                    } finally {
                        _cesiumkitCmdSeq = cmd.seq;
                    }
                }
            } catch (_) {
                // The static HTML export has no runtime server.
            } finally {
                setTimeout(_cesiumkitPollCommands, 250);
            }
        }
        _cesiumkitPollCommands();
    </script>
</body>
</html>
